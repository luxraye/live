{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --enable-source-maps ./dist/index.mjs",
    "dev:full": "pnpm run build && pnpm run dev",
