# API server configuration
NODE_ENV=development
PORT=5000

# Clerk authentication (required in production)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Comma-separated Clerk user IDs permitted to use admin routes
ADMIN_USER_IDS=

# Comma-separated browser origins. Never use * in production.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Development-only pilot mode. Keep false or unset in production.
PILOT_AUTH_ENABLED=false

# PostgreSQL connection string (required in production)
DATABASE_URL=

# Fabric gateway configuration (both required in production)
FABRIC_NODE_URL=http://localhost:3001
FABRIC_GATEWAY_SECRET=