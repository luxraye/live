# ─── Bloodchain Fabric Node — Environment Variables ───────────────────────────

# When true: all chaincode calls are simulated in-memory. The service runs
# perfectly without any real Fabric network. Set to false to connect to a peer.
FABRIC_MOCK_MODE=true

# gRPC endpoint of the Hyperledger Fabric peer.
FABRIC_PEER_ENDPOINT=localhost:7051

# TLS server name override (must match the peer's TLS cert CN).
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com

# The MSP ID of the organisation submitting transactions.
FABRIC_MSP_ID=Org1MSP

# The peer's TLS root certificate (Base64-encoded PEM).
FABRIC_TLS_CERT=

# The identity certificate of the gateway user (Base64-encoded PEM).
FABRIC_CERT=

# The private key of the gateway user (Base64-encoded PEM).
FABRIC_KEY=

# Shared secret used by the api-server to authenticate calls to /fabric/* routes.
# Sent as: Authorization: Bearer <FABRIC_GATEWAY_SECRET>
# Generate with: openssl rand -hex 32
FABRIC_GATEWAY_SECRET=change-me-to-a-random-64-char-hex-string

# Comma-separated CORS allow list.
ALLOWED_ORIGINS=http://localhost:5173,https://bloodchain.life,https://www.bloodchain.life

PORT=3001
